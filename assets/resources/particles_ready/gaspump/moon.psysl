<particles_layout>
    <world_emitting value="1" />
    <parameters>
        <parameter type="Float">
            <position x="10" y="10" />
            <name value="Life time" />
            <burstCollective value="0" />
            <distribution type="fixed">
                <fixed value="0" />
            </distribution>
        </parameter>
        <parameter type="Vector3">
            <position x="10" y="60" />
            <name value="Position" />
            <burstCollective value="0" />
            <distribution type="box_random">
                <box_random>
                    <from x="-35" y="-35" z="0" />
                    <to x="35" y="35" z="0" />
                </box_random>
            </distribution>
        </parameter>
        <parameter type="Spawn Global Position">
            <position x="10" y="110" />
            <name value="Spawn world. pos." />
        </parameter>
        <parameter type="Float">
            <position x="10" y="160" />
            <name value="size" />
            <burstCollective value="0" />
            <distribution type="linear_random">
                <linear_random>
                    <from value="80" />
                    <to value="100" />
                </linear_random>
            </distribution>
        </parameter>
        <parameter type="Vector3">
            <position x="10" y="210" />
            <name value="color" />
            <burstCollective value="0" />
            <distribution type="fixed_vector">
                <fixed_vector x="0.800000012" y="1" z="0.800000012" />
            </distribution>
        </parameter>
        <parameter type="Float">
            <position x="10" y="260" />
            <name value="rotation" />
            <burstCollective value="0" />
            <distribution type="linear_random">
                <linear_random>
                    <from value="0" />
                    <to value="360" />
                </linear_random>
            </distribution>
        </parameter>
        <parameter type="Float">
            <position x="10" y="310" />
            <name value="rotationRandom" />
            <burstCollective value="0" />
            <distribution type="linear_random">
                <linear_random>
                    <from value="0" />
                    <to value="5" />
                </linear_random>
            </distribution>
        </parameter>
        <parameter type="Float">
            <position x="10" y="360" />
            <name value="rotationWay" />
            <burstCollective value="0" />
            <distribution type="linear_random">
                <linear_random>
                    <from value="-1" />
                    <to value="1" />
                </linear_random>
            </distribution>
        </parameter>
    </parameters>
