        <function type="Mul">
            <position x="185" y="468" />
        </function>
        <function type="Distribution">
            <position x="185" y="538" />
            <distribution type="fixed">
                <fixed value="200" />
            </distribution>
        </function>
    </functions>
    <generator type="Generator">
        <position x="707" y="10" />
        <phase_distribution type="fixed">
            <fixed value="1" />
        </phase_distribution>
        <time_distribution type="fixed">
            <fixed value="5" />
        </time_distribution>
        <burst_distribution type="fixed">
            <fixed value="1" />
        </burst_distribution>
    </generator>
    <terminator type="Terminator: v1 &lt; v2">
        <position x="707" y="250" />
    </terminator>
    <constructor type="Constructor">
        <position x="707" y="310" />
        <slice_tex x="1" y="1" />
        <texture src="particles_ready/sprites/sun_ray.png" />
        <material src="materials/quad_tex_add.mat" />
