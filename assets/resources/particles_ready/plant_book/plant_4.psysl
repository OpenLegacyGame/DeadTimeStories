            <gravity x="-1.000000" y="-0.100000" z="-1.000000" />
        </modifier>
        <modifier type="Linear addition">
            <position x="707" y="190" />
            <speed value="3000" />
        </modifier>
    </modifiers>
    <functions>
        <function type="Distribution">
            <position x="376" y="331" />
