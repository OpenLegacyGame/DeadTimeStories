<particles_layout>
    <world_emitting value="0" />
    <parameters>
        <parameter type="Float">
            <position x="10" y="10" />
            <name value="terminate" />
            <burstCollective value="0" />
            <distribution type="fixed">
                <fixed value="5" />
            </distribution>
        </parameter>
        <parameter type="Float">
            <position x="10" y="60" />
            <name value="Life time" />
            <burstCollective value="0" />
            <distribution type="fixed">
                <fixed value="0" />
            </distribution>
        </parameter>
        <parameter type="Vector3">
            <position x="10" y="110" />
            <name value="Position" />
            <burstCollective value="0" />
            <distribution type="box_random">
                <box_random>
                    <from x="0" y="0" z="0" />
                    <to x="1024" y="180" z="0" />
                </box_random>
            </distribution>
        </parameter>
        <parameter type="Float">
            <position x="10" y="160" />
            <name value="size" />
            <burstCollective value="0" />
            <distribution type="linear_random">
                <linear_random>
                    <from value="100" />
                    <to value="200" />
                </linear_random>
            </distribution>
        </parameter>
        <parameter type="Float">
            <position x="10" y="210" />
            <name value="rotation" />
            <burstCollective value="0" />
            <distribution type="linear_random">
                <linear_random>
                    <from value="0" />
                    <to value="360" />
                </linear_random>
            </distribution>
        </parameter>
        <parameter type="Vector3">
            <position x="10" y="260" />
            <name value="color" />
            <burstCollective value="0" />
            <distribution type="linear_random_vector">
                <linear_random_vector>
                    <from x="0.300000012" y="0.400000006" z="0.300000012" />
                    <to x="0" y="0" z="0" />
                </linear_random_vector>
            </distribution>
        </parameter>
    </parameters>
    <modifiers>
        <modifier type="Linear addition">
            <position x="715" y="70" />
            <speed value="1" />
        </modifier>
        <modifier type="Linear addition">
            <position x="715" y="130" />
            <speed value="10" />
        </modifier>
        <modifier type="Linear addition">
            <position x="715" y="190" />
            <speed value="-4" />
        </modifier>
    </modifiers>
    <functions>
        <function type="Div">
            <position x="264" y="366" />
        </function>
        <function type="InterpTrack">
            <position x="432" y="102" />
            <track>
                <looped left="0" right="0" />
                <key type="4" corner="0" broken="0" time="0" in="0" out="0" intanx="-0.449999988" intany="-0" outtanx="0.0895370618" outtany="0.441002369" />
                <key type="3" corner="0" broken="0" time="0.202451289" in="0.997145772" out="0.997145772" intanx="-0.449999899" intany="0.000264149799" outtanx="0.449999899" outtany="-0.000264149799" />
                <key type="3" corner="0" broken="0" time="0.801893651" in="0.990680695" out="0.990680695" intanx="-0.449983418" intany="0.00386165199" outtanx="0.449983418" outtany="-0.00386165222" />
                <key type="4" corner="0" broken="0" time="1" in="0" out="0" intanx="-0.0882394984" intany="0.441263855" outtanx="1" outtany="0" />
            </track>
        </function>
    </functions>
    <generator type="Generator">
        <position x="715" y="10" />
        <phase_distribution type="fixed">
            <fixed value="1" />
        </phase_distribution>
        <time_distribution type="fixed">
            <fixed value="0.5" />
        </time_distribution>
        <burst_distribution type="fixed">
            <fixed value="3" />
        </burst_distribution>
    </generator>
    <terminator type="Terminator: v1 &lt; v2">
        <position x="715" y="250" />
    </terminator>
    <constructor type="Constructor">
        <position x="715" y="310" />
        <slice_tex x="1" y="1" />
        <texture src="particles_ready/sprites/dust.tga" />
        <material src="materials/quad_tex.mat" />
    </constructor>
    <connections>
        <connection input_block="1" input_index="0" output_block="6" output_index="0" />
        <connection input_block="3" input_index="0" output_block="8" output_index="0" />
        <connection input_block="4" input_index="0" output_block="7" output_index="0" />
        <connection input_block="6" input_index="0" output_block="1" output_index="0" />
        <connection input_block="7" input_index="0" output_block="4" output_index="0" />
        <connection input_block="8" input_index="0" output_block="3" output_index="0" />
        <connection input_block="9" input_index="0" output_block="1" output_index="0" />
        <connection input_block="9" input_index="1" output_block="0" output_index="0" />
        <connection input_block="10" input_index="0" output_block="9" output_index="0" />
        <connection input_block="12" input_index="0" output_block="0" output_index="0" />
        <connection input_block="12" input_index="1" output_block="1" output_index="0" />
        <connection input_block="13" input_index="0" output_block="2" output_index="0" />
        <connection input_block="13" input_index="1" output_block="3" output_index="0" />
        <connection input_block="13" input_index="2" output_block="5" output_index="0" />
        <connection input_block="13" input_index="3" output_block="10" output_index="0" />
        <connection input_block="13" input_index="4" output_block="4" output_index="0" />
    </connections>
</particles_layout>
