                <fixed value="0" />
            </distribution>
        </parameter>
        <parameter type="Vector3">
            <position x="10" y="110" />
            <name value="Position" />
            <burstCollective value="0" />
            <distribution type="box_random">
                <box_random>
                    <from x="0" y="0" z="0" />
                    <to x="1024" y="500" z="0" />
                </box_random>
            </distribution>
        </parameter>
        <parameter type="Vector3">
