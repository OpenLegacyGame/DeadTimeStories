<particles_layout>
    <world_emitting value="0" />
    <parameters>
        <parameter type="Float">
            <position x="10" y="10" />
            <name value="terminate" />
            <burstCollective value="0" />
            <distribution type="fixed">
                <fixed value="5" />
            </distribution>
        </parameter>
        <parameter type="Float">
            <position x="10" y="60" />
            <name value="Life time" />
            <burstCollective value="0" />
            <distribution type="fixed">
                <fixed value="0" />
            </distribution>
        </parameter>
        <parameter type="Vector3">
            <position x="10" y="110" />
            <name value="Position" />
            <burstCollective value="0" />
            <distribution type="box_random">
                <box_random>
                    <from x="0" y="0" z="0" />
                    <to x="1024" y="250" z="0" />
                </box_random>
            </distribution>
        </parameter>
        <parameter type="Float">
            <position x="10" y="160" />
            <name value="size" />
            <burstCollective value="0" />
            <distribution type="linear_random">
                <linear_random>
                    <from value="200" />
                    <to value="300" />
                </linear_random>
            </distribution>
        </parameter>
        <parameter type="Float">
            <position x="10" y="210" />
            <name value="rotation" />
            <burstCollective value="0" />
            <distribution type="linear_random">
                <linear_random>
                    <from value="0" />
                    <to value="360" />
                </linear_random>
            </distribution>
        </parameter>
        <parameter type="Vector3">
            <position x="10" y="260" />
            <name value="color" />
            <burstCollective value="0" />
            <distribution type="linear_random_vector">
                <linear_random_vector>
                    <from x="0.100000001" y="0.150000006" z="0.200000003" />
                    <to x="0.100000001" y="0.200000003" z="0.300000012" />
                </linear_random_vector>
            </distribution>
        </parameter>
    </parameters>
    <modifiers>
        <modifier type="Linear addition">
            <position x="684" y="70" />
            <speed value="1" />
        </modifier>
        <modifier type="Linear addition">
            <position x="684" y="130" />
            <speed value="10" />
        </modifier>
        <modifier type="Linear addition">
            <position x="684" y="190" />
            <speed value="-4" />
        </modifier>
    </modifiers>
    <functions>
        <function type="Div">
            <position x="264" y="366" />
        </function>
        <function type="InterpTrack">
            <position x="433" y="100" />
            <track>
                <looped left="0" right="0" />
                <key type="4" corner="0" broken="0" time="0" in="0" out="0" intanx="-0.449999988" intany="-0" outtanx="0.142302498" outtany="0.42690748" />
                <key type="3" corner="0" broken="0" time="0.200000003" in="0.600000024" out="0.600000024" intanx="-0.449973285" intany="0.00490159169" outtanx="0.449973315" outtany="-0.00490159169" />
                <key type="3" corner="0" broken="0" time="0.800000012" in="0.600000024" out="0.600000024" intanx="-0.44999975" intany="-0.000459325587" outtanx="0.44999975" outtany="0.000459325529" />
                <key type="4" corner="0" broken="0" time="1" in="0" out="0" intanx="-0.142302483" intany="0.42690748" outtanx="1" outtany="0" />
            </track>
        </function>
    </functions>
    <generator type="Generator">
        <position x="684" y="10" />
        <phase_distribution type="fixed">
            <fixed value="0" />
        </phase_distribution>
        <time_distribution type="fixed">
            <fixed value="0.5" />
        </time_distribution>
        <burst_distribution type="fixed">
            <fixed value="5" />
        </burst_distribution>
    </generator>
    <terminator type="Terminator: v1 &lt; v2">
        <position x="684" y="250" />
    </terminator>
    <constructor type="Constructor">
        <position x="684" y="310" />
        <slice_tex x="1" y="1" />
        <texture src="particles_ready/sprites/smoke.png" />
        <material src="materials/quad_tex_add.mat" />
    </constructor>
    <connections>
        <connection input_block="1" input_index="0" output_block="6" output_index="0" />
        <connection input_block="3" input_index="0" output_block="8" output_index="0" />
        <connection input_block="4" input_index="0" output_block="7" output_index="0" />
        <connection input_block="6" input_index="0" output_block="1" output_index="0" />
        <connection input_block="7" input_index="0" output_block="4" output_index="0" />
        <connection input_block="8" input_index="0" output_block="3" output_index="0" />
        <connection input_block="9" input_index="0" output_block="1" output_index="0" />
        <connection input_block="9" input_index="1" output_block="0" output_index="0" />
        <connection input_block="10" input_index="0" output_block="9" output_index="0" />
        <connection input_block="12" input_index="0" output_block="0" output_index="0" />
        <connection input_block="12" input_index="1" output_block="1" output_index="0" />
        <connection input_block="13" input_index="0" output_block="2" output_index="0" />
        <connection input_block="13" input_index="1" output_block="3" output_index="0" />
        <connection input_block="13" input_index="2" output_block="5" output_index="0" />
        <connection input_block="13" input_index="3" output_block="10" output_index="0" />
        <connection input_block="13" input_index="4" output_block="4" output_index="0" />
    </connections>
</particles_layout>
