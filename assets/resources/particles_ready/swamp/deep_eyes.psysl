<particles_layout>
    <world_emitting value="1" />
    <parameters>
        <parameter type="Float">
            <position x="10" y="10" />
            <name value="Life time" />
            <burstCollective value="0" />
            <distribution type="fixed">
                <fixed value="0" />
            </distribution>
        </parameter>
        <parameter type="Vector3">
            <position x="10" y="60" />
            <name value="Position" />
            <burstCollective value="0" />
            <distribution type="box_random">
                <box_random>
                    <from x="-10" y="-10" z="0" />
                    <to x="10" y="10" z="0" />
                </box_random>
            </distribution>
        </parameter>
        <parameter type="Spawn Global Position">
            <position x="10" y="110" />
            <name value="Spawn world. pos." />
        </parameter>
        <parameter type="Float">
            <position x="10" y="160" />
            <name value="terminate" />
            <burstCollective value="0" />
            <distribution type="fixed">
                <fixed value="4" />
            </distribution>
        </parameter>
        <parameter type="Float">
            <position x="10" y="210" />
            <name value="size" />
            <burstCollective value="0" />
            <distribution type="linear_random">
                <linear_random>
                    <from value="3" />
                    <to value="10" />
                </linear_random>
            </distribution>
        </parameter>
        <parameter type="Vector3">
            <position x="10" y="260" />
            <name value="color" />
            <burstCollective value="0" />
            <distribution type="fixed_vector">
                <fixed_vector x="1" y="0" z="0" />
            </distribution>
        </parameter>
        <parameter type="Float">
            <position x="10" y="310" />
            <name value="rotation" />
            <burstCollective value="0" />
            <distribution type="fixed">
                <fixed value="0" />
            </distribution>
        </parameter>
    </parameters>
    <modifiers>
