                <key type="3" corner="0" broken="0" time="0.323977172" in="1" out="1" intanx="-0.449999779" intany="0.000475820154" outtanx="0.449999779" outtany="-0.000475820154" />
                <key type="3" corner="0" broken="0" time="0.800000012" in="1" out="1" intanx="-0.449952066" intany="-0.00656814734" outtanx="0.449952066" outtany="0.0065681478" />
                <key type="3" corner="0" broken="0" time="1" in="0" out="0" intanx="-0.0707645789" intany="0.444401145" outtanx="0.449999988" outtany="0" />
