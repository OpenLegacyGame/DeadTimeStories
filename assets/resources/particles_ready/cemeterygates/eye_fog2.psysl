        </phase_distribution>
        <time_distribution type="fixed">
            <fixed value="9" />
        </time_distribution>
        <burst_distribution type="fixed">
            <fixed value="30" />
        </burst_distribution>
    </generator>
    <terminator type="Terminator: v1 &lt; v2">
        <position x="684" y="190" />
