        <function type="InterpTrack">
            <position x="301" y="335" />
            <track>
                <looped left="0" right="0" />
                <key type="4" corner="0" broken="0" time="0" in="0" out="0" intanx="-1" intany="0" outtanx="0.231523082" outtany="0.385871798" />
                <key type="3" corner="0" broken="0" time="0.300000012" in="0.5" out="0.5" intanx="-0.449948579" intany="0.0068016001" outtanx="0.449948609" outtany="-0.0068016001" />
                <key type="3" corner="0" broken="0" time="0.699999988" in="0.5" out="0.5" intanx="-0.449946105" intany="-0.0069632926" outtanx="0.449946105" outtany="0.0069632926" />
                <key type="4" corner="0" broken="0" time="1" in="0" out="0" intanx="-0.231523082" intany="0.385871798" outtanx="0.449999988" outtany="0" />
            </track>
        </function>
    </functions>
    <generator type="Generator">
