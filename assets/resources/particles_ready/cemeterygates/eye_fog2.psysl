        </parameter>
        <parameter type="Float">
            <position x="10" y="210" />
            <name value="rotation" />
            <burstCollective value="0" />
            <distribution type="linear_random">
                <linear_random>
                    <from value="0" />
                    <to value="360" />
                </linear_random>
            </distribution>
        </parameter>
        <parameter type="Vector3">
            <position x="10" y="260" />
            <name value="color" />
            <burstCollective value="0" />
            <distribution type="fixed_vector">
                <fixed_vector x="1" y="0.300000012" z="0.300000012" />
            </distribution>
        </parameter>
    </parameters>
    <modifiers>
        <modifier type="Linear addition">
            <position x="684" y="70" />
            <speed value="1" />
        </modifier>
        <modifier type="Linear addition">
            <position x="684" y="130" />
            <speed value="30" />
        </modifier>
    </modifiers>
    <functions>
