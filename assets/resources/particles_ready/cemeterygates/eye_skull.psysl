                <key type="4" corner="0" broken="0" time="0" in="0.5" out="0.5" intanx="-1" intany="0" outtanx="0.385871798" outtany="0.231523082" />
                <key type="4" corner="0" broken="0" time="0.5" in="0.800000012" out="0.800000012" intanx="-0.449999988" intany="-0" outtanx="0.449999988" outtany="0" />
                <key type="4" corner="0" broken="0" time="1" in="0.5" out="0.5" intanx="-0.385871798" intany="0.231523082" outtanx="0.449999988" outtany="0" />
