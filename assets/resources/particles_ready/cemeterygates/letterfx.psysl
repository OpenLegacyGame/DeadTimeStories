<particles_layout>
    <world_emitting value="0" />
    <parameters>
        <parameter type="Float">
            <position x="10" y="10" />
            <name value="Life time" />
            <burstCollective value="0" />
            <distribution type="fixed">
                <fixed value="0" />
            </distribution>
        </parameter>
        <parameter type="Vector3">
            <position x="10" y="60" />
            <name value="Position" />
            <burstCollective value="0" />
            <distribution type="box_random">
                <box_random>
                    <from x="0" y="0" z="0" />
                    <to x="0" y="0" z="0" />
                </box_random>
            </distribution>
        </parameter>
        <parameter type="Vector3">
            <position x="10" y="110" />
            <name value="Velocity" />
            <burstCollective value="0" />
            <distribution type="box_random">
                <box_random>
                    <from x="-3" y="-3" z="0" />
                    <to x="3" y="3" z="0" />
                </box_random>
            </distribution>
        </parameter>
        <parameter type="Float">
            <position x="10" y="160" />
            <name value="Rotation" />
            <burstCollective value="0" />
            <distribution type="linear_random">
                <linear_random>
                    <from value="0" />
                    <to value="360" />
                </linear_random>
            </distribution>
        </parameter>
        <parameter type="Float">
            <position x="10" y="210" />
            <name value="Size" />
            <burstCollective value="0" />
            <distribution type="linear_random">
                <linear_random>
                    <from value="5" />
                    <to value="40" />
                </linear_random>
            </distribution>
        </parameter>
    </parameters>
