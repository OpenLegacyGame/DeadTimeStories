<particles_layout>
    <world_emitting value="0" />
    <parameters>
        <parameter type="Float">
            <position x="10" y="10" />
            <name value="Life time" />
            <burstCollective value="0" />
            <distribution type="fixed">
                <fixed value="0" />
            </distribution>
        </parameter>
        <parameter type="Vector3">
            <position x="10" y="60" />
            <name value="Position" />
            <burstCollective value="0" />
            <distribution type="linear_random_vector">
                <linear_random_vector>
                    <from x="-2" y="0" z="0" />
                    <to x="2" y="0" z="0" />
                </linear_random_vector>
            </distribution>
        </parameter>
        <parameter type="Float">
            <position x="10" y="110" />
            <name value="terminate" />
            <burstCollective value="0" />
            <distribution type="fixed">
                <fixed value="0.100000001" />
            </distribution>
        </parameter>
        <parameter type="Float">
            <position x="10" y="160" />
            <name value="size" />
            <burstCollective value="0" />
            <distribution type="fixed">
                <fixed value="200" />
            </distribution>
        </parameter>
        <parameter type="Vector3">
            <position x="10" y="210" />
            <name value="color" />
            <burstCollective value="0" />
            <distribution type="fixed_vector">
                <fixed_vector x="1" y="0.899999976" z="0.5" />
            </distribution>
        </parameter>
        <parameter type="Float">
            <position x="10" y="260" />
            <name value="alpha" />
            <burstCollective value="0" />
            <distribution type="fixed">
                <fixed value="0.100000001" />
            </distribution>
        </parameter>
        <parameter type="Float">
            <position x="10" y="310" />
            <name value="rotation" />
            <burstCollective value="0" />
            <distribution type="fixed">
                <fixed value="0" />
            </distribution>
        </parameter>
    </parameters>
    <modifiers>
        <modifier type="Linear addition">
            <position x="684" y="70" />
            <speed value="1" />
        </modifier>
    </modifiers>
    <functions />
    <generator type="Generator">
        <position x="684" y="10" />
        <phase_distribution type="linear_random">
            <linear_random>
                <from value="0" />
                <to value="1" />
            </linear_random>
        </phase_distribution>
        <time_distribution type="fixed">
            <fixed value="0.10000000000000001" />
        </time_distribution>
        <burst_distribution type="fixed">
            <fixed value="1" />
        </burst_distribution>
    </generator>
    <terminator type="Terminator: v1 &lt; v2">
        <position x="684" y="130" />
    </terminator>
    <constructor type="Constructor">
        <position x="684" y="190" />
        <slice_tex x="1" y="1" />
        <texture src="particles_ready/sprites/glow.png" />
        <material src="materials/quad_tex_add.mat" />
    </constructor>
    <connections>
        <connection input_block="0" input_index="0" output_block="7" output_index="0" />
        <connection input_block="7" input_index="0" output_block="0" output_index="0" />
        <connection input_block="9" input_index="0" output_block="2" output_index="0" />
        <connection input_block="9" input_index="1" output_block="0" output_index="0" />
        <connection input_block="10" input_index="0" output_block="1" output_index="0" />
        <connection input_block="10" input_index="1" output_block="3" output_index="0" />
        <connection input_block="10" input_index="2" output_block="4" output_index="0" />
        <connection input_block="10" input_index="3" output_block="5" output_index="0" />
        <connection input_block="10" input_index="4" output_block="6" output_index="0" />
    </connections>
</particles_layout>
