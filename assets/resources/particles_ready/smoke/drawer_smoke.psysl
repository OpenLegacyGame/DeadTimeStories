<particles_layout>
    <world_emitting value="1" />
    <parameters>
        <parameter type="Float">
            <position x="10" y="10" />
            <name value="Life time" />
            <burstCollective value="0" />
            <distribution type="fixed">
                <fixed value="0" />
            </distribution>
        </parameter>
        <parameter type="Vector3">
            <position x="10" y="60" />
            <name value="Position" />
            <burstCollective value="0" />
            <distribution type="linear_random_vector">
                <linear_random_vector>
                    <from x="-1.5" y="0" z="0" />
                    <to x="1.5" y="0" z="0" />
                </linear_random_vector>
            </distribution>
        </parameter>
        <parameter type="Spawn Global Position">
            <position x="10" y="110" />
            <name value="Spawn world. pos." />
        </parameter>
        <parameter type="Vector3">
            <position x="10" y="160" />
            <name value="Velocity" />
            <burstCollective value="0" />
            <distribution type="box_random">
                <box_random>
                    <from x="0" y="-30" z="0" />
                    <to x="0" y="-40" z="0" />
                </box_random>
            </distribution>
        </parameter>
        <parameter type="Float">
            <position x="10" y="210" />
            <name value="terminate" />
            <burstCollective value="0" />
            <distribution type="fixed">
                <fixed value="1" />
            </distribution>
        </parameter>
        <parameter type="Float">
            <position x="10" y="260" />
            <name value="size" />
            <burstCollective value="0" />
            <distribution type="fixed">
                <fixed value="3" />
            </distribution>
        </parameter>
        <parameter type="Vector3">
            <position x="10" y="310" />
            <name value="color" />
            <burstCollective value="0" />
            <distribution type="fixed_vector">
                <fixed_vector x="1" y="1" z="1" />
            </distribution>
        </parameter>
        <parameter type="Float">
            <position x="10" y="360" />
            <name value="alpha" />
            <burstCollective value="0" />
            <distribution type="fixed">
                <fixed value="1" />
            </distribution>
        </parameter>
        <parameter type="Float">
            <position x="10" y="410" />
            <name value="rotate" />
            <burstCollective value="0" />
            <distribution type="linear_random">
                <linear_random>
                    <from value="0" />
                    <to value="360" />
                </linear_random>
            </distribution>
        </parameter>
    </parameters>
    <modifiers>
        <modifier type="Linear addition">
            <position x="711" y="70" />
            <speed value="1" />
        </modifier>
        <modifier type="Move">
            <position x="711" y="130" />
        </modifier>
        <modifier type="Linear addition">
            <position x="711" y="190" />
            <speed value="24" />
        </modifier>
        <modifier type="Linear addition">
            <position x="711" y="250" />
            <speed value="-1" />
        </modifier>
    </modifiers>
    <functions>
        <function type="Add (vector)">
            <position x="174" y="121" />
        </function>
        <function type="Split">
            <position x="206" y="524" />
        </function>
        <function type="Add">
            <position x="529" y="535" />
        </function>
        <function type="Mul">
            <position x="367" y="579" />
        </function>
        <function type="Distribution">
            <position x="351" y="512" />
            <distribution type="fixed">
                <fixed value="0.0700000003" />
            </distribution>
        </function>
        <function type="Add">
            <position x="409" y="292" />
        </function>
    </functions>
    <generator type="Generator">
        <position x="711" y="10" />
        <time_distribution type="linear_random">
            <linear_random>
                <from value="0.080000000000000002" />
                <to value="0.10000000000000001" />
            </linear_random>
        </time_distribution>
        <burst_distribution type="fixed">
            <fixed value="1" />
        </burst_distribution>
    </generator>
    <terminator type="Terminator: v1 &lt; v2">
        <position x="711" y="310" />
    </terminator>
    <constructor type="Constructor">
        <position x="711" y="370" />
        <slice_tex x="1" y="1" />
        <texture src="particles_ready/sprites/smoke.png" />
        <material src="materials/quad_tex.mat" />
    </constructor>
    <connections>
        <connection input_block="0" input_index="0" output_block="9" output_index="0" />
        <connection input_block="1" input_index="0" output_block="10" output_index="0" />
        <connection input_block="5" input_index="0" output_block="11" output_index="0" />
        <connection input_block="7" input_index="0" output_block="12" output_index="0" />
        <connection input_block="9" input_index="0" output_block="0" output_index="0" />
        <connection input_block="10" input_index="0" output_block="1" output_index="0" />
        <connection input_block="10" input_index="1" output_block="3" output_index="0" />
        <connection input_block="11" input_index="0" output_block="5" output_index="0" />
        <connection input_block="12" input_index="0" output_block="7" output_index="0" />
        <connection input_block="13" input_index="0" output_block="1" output_index="0" />
        <connection input_block="13" input_index="1" output_block="2" output_index="0" />
        <connection input_block="14" input_index="0" output_block="2" output_index="0" />
        <connection input_block="15" input_index="0" output_block="5" output_index="0" />
        <connection input_block="15" input_index="1" output_block="16" output_index="0" />
        <connection input_block="16" input_index="0" output_block="17" output_index="0" />
        <connection input_block="16" input_index="1" output_block="14" output_index="2" />
        <connection input_block="18" input_index="0" output_block="4" output_index="0" />
        <connection input_block="18" input_index="1" output_block="15" output_index="0" />
        <connection input_block="20" input_index="0" output_block="4" output_index="0" />
        <connection input_block="20" input_index="1" output_block="0" output_index="0" />
        <connection input_block="21" input_index="0" output_block="13" output_index="0" />
        <connection input_block="21" input_index="1" output_block="18" output_index="0" />
        <connection input_block="21" input_index="2" output_block="6" output_index="0" />
        <connection input_block="21" input_index="3" output_block="7" output_index="0" />
        <connection input_block="21" input_index="4" output_block="8" output_index="0" />
    </connections>
</particles_layout>
