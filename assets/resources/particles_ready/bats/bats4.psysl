<particles_layout>
    <world_emitting value="0" />
    <parameters>
        <parameter type="Vector3">
            <position x="10" y="10" />
            <name value="Position" />
            <burstCollective value="0" />
            <distribution type="box_random">
                <box_random>
                    <from x="0" y="0" z="0" />
                    <to x="500" y="50" z="0" />
                </box_random>
            </distribution>
        </parameter>
        <parameter type="Vector3">
            <position x="10" y="60" />
            <name value="Velocity" />
            <burstCollective value="0" />
            <distribution type="linear_random_vector">
                <linear_random_vector>
                    <from x="-100" y="50" z="0" />
                    <to x="100" y="100" z="0" />
                </linear_random_vector>
            </distribution>
        </parameter>
        <parameter type="Vector3">
            <position x="10" y="110" />
            <name value="color" />
            <burstCollective value="0" />
            <distribution type="fixed_vector">
                <fixed_vector x="1" y="1" z="1" />
            </distribution>
        </parameter>
        <parameter type="Float">
            <position x="10" y="160" />
            <name value="size" />
            <burstCollective value="0" />
            <distribution type="linear_random">
                <linear_random>
                    <from value="50" />
                    <to value="30" />
                </linear_random>
            </distribution>
        </parameter>
        <parameter type="Float">
            <position x="10" y="210" />
            <name value="alpha" />
            <burstCollective value="0" />
            <distribution type="fixed">
                <fixed value="0.600000024" />
            </distribution>
        </parameter>
        <parameter type="Float">
            <position x="10" y="260" />
            <name value="rotation" />
            <burstCollective value="0" />
            <distribution type="fixed">
                <fixed value="0" />
            </distribution>
        </parameter>
    </parameters>
    <modifiers>
        <modifier type="Move">
            <position x="684" y="70" />
        </modifier>
        <modifier type="Gravity">
            <position x="684" y="130" />
            <gravity x="100.000000" y="0.000000" z="0.000000" />
        </modifier>
        <modifier type="Linear addition">
            <position x="684" y="190" />
            <speed value="-30" />
        </modifier>
    </modifiers>
    <functions>
        <function type="Distribution">
            <position x="394" y="393" />
            <distribution type="fixed">
                <fixed value="2" />
            </distribution>
        </function>
    </functions>
    <generator type="Generator">
        <position x="684" y="10" />
        <phase_distribution type="fixed">
            <fixed value="1" />
        </phase_distribution>
        <time_distribution type="linear_random">
            <linear_random>
                <from value="2" />
                <to value="8" />
            </linear_random>
        </time_distribution>
        <burst_distribution type="linear_random">
            <linear_random>
                <from value="1" />
                <to value="3" />
            </linear_random>
        </burst_distribution>
    </generator>
    <terminator type="Terminator: v1 &lt; v2">
        <position x="684" y="250" />
    </terminator>
    <constructor type="Constructor">
        <position x="684" y="310" />
        <slice_tex x="1" y="1" />
        <texture src="particles_ready/bats/bat.ifl" />
        <material src="materials/quad_tex.mat" />
    </constructor>
    <connections>
        <connection input_block="0" input_index="0" output_block="6" output_index="0" />
        <connection input_block="1" input_index="0" output_block="7" output_index="0" />
        <connection input_block="3" input_index="0" output_block="8" output_index="0" />
        <connection input_block="6" input_index="0" output_block="0" output_index="0" />
        <connection input_block="6" input_index="1" output_block="1" output_index="0" />
        <connection input_block="7" input_index="0" output_block="1" output_index="0" />
        <connection input_block="8" input_index="0" output_block="3" output_index="0" />
        <connection input_block="11" input_index="0" output_block="3" output_index="0" />
        <connection input_block="11" input_index="1" output_block="9" output_index="0" />
        <connection input_block="12" input_index="0" output_block="0" output_index="0" />
        <connection input_block="12" input_index="1" output_block="3" output_index="0" />
        <connection input_block="12" input_index="2" output_block="2" output_index="0" />
        <connection input_block="12" input_index="3" output_block="4" output_index="0" />
        <connection input_block="12" input_index="4" output_block="5" output_index="0" />
    </connections>
</particles_layout>
