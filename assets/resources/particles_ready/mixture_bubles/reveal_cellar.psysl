<particles_layout>
    <world_emitting value="0" />
    <parameters>
        <parameter type="Float">
            <position x="10" y="10" />
            <name value="Life time" />
            <burstCollective value="0" />
            <distribution type="fixed">
                <fixed value="0" />
            </distribution>
        </parameter>
        <parameter type="Spawn Global Position">
            <position x="10" y="60" />
            <name value="Spawn world. pos." />
        </parameter>
        <parameter type="Vector3">
            <position x="10" y="110" />
            <name value="Position" />
            <burstCollective value="0" />
            <distribution type="box_random">
                <box_random>
                    <from x="47" y="28" z="0" />
                    <to x="97" y="58" z="0" />
                </box_random>
            </distribution>
        </parameter>
        <parameter type="Float">
            <position x="10" y="160" />
            <name value="Float" />
            <burstCollective value="0" />
            <distribution type="linear_random">
                <linear_random>
                    <from value="15" />
                    <to value="25" />
                </linear_random>
            </distribution>
        </parameter>
        <parameter type="Vector3">
            <position x="10" y="210" />
            <name value="Vector3" />
            <burstCollective value="0" />
            <distribution type="box_random">
                <box_random>
                    <from x="0.5" y="0.5" z="0.5" />
                    <to x="1" y="1" z="1" />
                </box_random>
            </distribution>
        </parameter>
    </parameters>
    <modifiers>
        <modifier type="Linear addition">
            <position x="684" y="70" />
            <speed value="1" />
        </modifier>
    </modifiers>
    <functions>
        <function type="Distribution">
            <position x="134" y="62" />
            <distribution type="fixed">
                <fixed value="0.5" />
            </distribution>
        </function>
        <function type="Div">
            <position x="215" y="109" />
        </function>
        <function type="Add (vector)">
            <position x="348" y="62" />
        </function>
        <function type="Distribution">
            <position x="348" y="222" />
            <distribution type="fixed">
                <fixed value="1" />
            </distribution>
        </function>
        <function type="Distribution">
            <position x="359" y="253" />
            <distribution type="fixed">
                <fixed value="180" />
            </distribution>
        </function>
    </functions>
    <generator type="Generator">
        <position x="684" y="10" />
        <phase_distribution type="fixed">
            <fixed value="1" />
        </phase_distribution>
        <time_distribution type="linear_random">
            <linear_random>
                <from value="0.10000000000000001" />
                <to value="0.40000000000000002" />
            </linear_random>
        </time_distribution>
        <burst_distribution type="fixed">
            <fixed value="1" />
        </burst_distribution>
    </generator>
    <terminator type="Terminator: v1 &lt; v2">
        <position x="684" y="130" />
    </terminator>
    <constructor type="Constructor">
        <position x="684" y="190" />
        <slice_tex x="1" y="1" />
        <texture src="particles_ready/mixture_bubles/bub.ifl" />
        <material src="materials/quad_tex_add.mat" />
    </constructor>
    <connections>
        <connection input_block="0" input_index="0" output_block="5" output_index="0" />
        <connection input_block="5" input_index="0" output_block="0" output_index="0" />
        <connection input_block="7" input_index="0" output_block="0" output_index="0" />
        <connection input_block="7" input_index="1" output_block="6" output_index="0" />
        <connection input_block="8" input_index="0" output_block="1" output_index="0" />
        <connection input_block="8" input_index="1" output_block="2" output_index="0" />
        <connection input_block="12" input_index="0" output_block="6" output_index="0" />
        <connection input_block="12" input_index="1" output_block="0" output_index="0" />
        <connection input_block="13" input_index="0" output_block="8" output_index="0" />
        <connection input_block="13" input_index="1" output_block="3" output_index="0" />
        <connection input_block="13" input_index="2" output_block="4" output_index="0" />
        <connection input_block="13" input_index="3" output_block="9" output_index="0" />
        <connection input_block="13" input_index="4" output_block="10" output_index="0" />
    </connections>
</particles_layout>
