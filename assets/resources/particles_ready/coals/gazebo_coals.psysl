<particles_layout>
    <world_emitting value="1" />
    <parameters>
        <parameter type="Float">
            <position x="10" y="10" />
            <name value="terminate" />
            <burstCollective value="0" />
            <distribution type="fixed">
                <fixed value="2" />
            </distribution>
        </parameter>
        <parameter type="Float">
            <position x="10" y="60" />
            <name value="Life time" />
            <burstCollective value="0" />
            <distribution type="fixed">
                <fixed value="0" />
            </distribution>
        </parameter>
        <parameter type="Vector3">
            <position x="10" y="110" />
            <name value="Position" />
            <burstCollective value="0" />
            <distribution type="box_random">
                <box_random>
                    <from x="742" y="256" z="0" />
                    <to x="770" y="268" z="0" />
                </box_random>
            </distribution>
        </parameter>
        <parameter type="Float">
            <position x="10" y="160" />
            <name value="size" />
            <burstCollective value="0" />
            <distribution type="linear_random">
                <linear_random>
                    <from value="5" />
                    <to value="20" />
                </linear_random>
            </distribution>
        </parameter>
        <parameter type="Float">
            <position x="10" y="210" />
            <name value="rotationRand" />
            <burstCollective value="0" />
            <distribution type="linear_random">
                <linear_random>
                    <from value="-20" />
                    <to value="20" />
                </linear_random>
            </distribution>
        </parameter>
        <parameter type="Vector3">
            <position x="10" y="260" />
            <name value="Vector3" />
            <burstCollective value="0" />
            <distribution type="fixed_vector">
                <fixed_vector x="0.400000006" y="0" z="0" />
            </distribution>
        </parameter>
    </parameters>
    <modifiers>
        <modifier type="Linear addition">
            <position x="607" y="70" />
            <speed value="1" />
        </modifier>
        <modifier type="Linear addition">
            <position x="607" y="130" />
            <speed value="-4" />
        </modifier>
    </modifiers>
    <functions>
        <function type="Div">
            <position x="264" y="366" />
        </function>
        <function type="Sub">
            <position x="441" y="415" />
        </function>
        <function type="Distribution">
            <position x="264" y="460" />
            <distribution type="fixed">
                <fixed value="0.5" />
            </distribution>
        </function>
        <function type="Mul">
            <position x="441" y="485" />
        </function>
        <function type="Mul">
            <position x="627" y="460" />
        </function>
        <function type="Distribution">
            <position x="441" y="537" />
            <distribution type="fixed">
                <fixed value="5" />
            </distribution>
        </function>
        <function type="Distribution">
            <position x="441" y="289" />
            <distribution type="fixed">
                <fixed value="1" />
            </distribution>
        </function>
        <function type="Sub">
            <position x="597" y="573" />
        </function>
        <function type="Mul">
            <position x="222" y="238" />
        </function>
    </functions>
    <generator type="Generator">
        <position x="607" y="10" />
        <phase_distribution type="fixed">
            <fixed value="0" />
        </phase_distribution>
        <time_distribution type="fixed">
            <fixed value="0.29999999999999999" />
        </time_distribution>
        <burst_distribution type="fixed">
            <fixed value="5" />
        </burst_distribution>
    </generator>
    <terminator type="Terminator: v1 &lt; v2">
        <position x="607" y="190" />
    </terminator>
    <constructor type="Constructor">
        <position x="607" y="250" />
        <slice_tex x="1" y="1" />
        <texture src="particles_ready/sprites/dirt.tga" />
        <material src="materials/quad_tex_add.mat" />
    </constructor>
