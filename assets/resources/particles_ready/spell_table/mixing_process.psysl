            </distribution>
        </parameter>
        <parameter type="Vector3">
            <position x="10" y="310" />
            <name value="color" />
            <burstCollective value="0" />
            <distribution type="fixed_vector">
                <fixed_vector x="1" y="1" z="1" />
            </distribution>
        </parameter>
        <parameter type="Float">
            <position x="10" y="360" />
            <name value="rotationRand" />
            <burstCollective value="0" />
            <distribution type="linear_random">
                <linear_random>
                    <from value="-150" />
                    <to value="150" />
                </linear_random>
            </distribution>
        </parameter>
        <parameter type="Float">
            <position x="10" y="410" />
            <name value="Float" />
            <burstCollective value="0" />
            <distribution type="linear_random">
                <linear_random>
                    <from value="0" />
                    <to value="360" />
                </linear_random>
            </distribution>
        </parameter>
    </parameters>
