<particles_layout>
    <world_emitting value="1" />
    <parameters>
        <parameter type="Float">
            <position x="10" y="10" />
            <name value="terminate" />
            <burstCollective value="0" />
            <distribution type="linear_random">
                <linear_random>
                    <from value="0.5" />
                    <to value="2" />
                </linear_random>
            </distribution>
        </parameter>
        <parameter type="Float">
            <position x="10" y="60" />
            <name value="Life time" />
            <burstCollective value="0" />
            <distribution type="fixed">
                <fixed value="0" />
            </distribution>
        </parameter>
        <parameter type="Vector3">
            <position x="10" y="110" />
            <name value="Position" />
            <burstCollective value="0" />
            <distribution type="fixed_vector">
                <fixed_vector x="19" y="98" z="0" />
            </distribution>
        </parameter>
        <parameter type="Spawn Global Position">
            <position x="10" y="160" />
            <name value="Spawn world. pos." />
        </parameter>
        <parameter type="Vector3">
            <position x="10" y="210" />
            <name value="Velocity" />
            <burstCollective value="0" />
            <distribution type="fixed_vector">
                <fixed_vector x="0" y="-100" z="0" />
            </distribution>
        </parameter>
        <parameter type="Float">
            <position x="10" y="260" />
            <name value="size" />
            <burstCollective value="0" />
            <distribution type="linear_random">
                <linear_random>
                    <from value="5" />
                    <to value="30" />
