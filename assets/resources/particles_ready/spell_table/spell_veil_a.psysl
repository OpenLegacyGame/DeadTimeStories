<particles_layout>
    <world_emitting value="1" />
    <parameters>
        <parameter type="Float">
            <position x="10" y="10" />
            <name value="terminate" />
            <burstCollective value="0" />
            <distribution type="fixed">
                <fixed value="3" />
            </distribution>
        </parameter>
        <parameter type="Float">
            <position x="10" y="60" />
            <name value="Life time" />
            <burstCollective value="0" />
            <distribution type="fixed">
                <fixed value="0" />
            </distribution>
        </parameter>
        <parameter type="Vector3">
            <position x="10" y="110" />
            <name value="Position" />
            <burstCollective value="0" />
            <distribution type="box_random">
                <box_random>
                    <from x="108" y="307" z="0" />
                    <to x="288" y="402" z="0" />
                </box_random>
            </distribution>
        </parameter>
        <parameter type="Vector3">
            <position x="10" y="160" />
            <name value="Velocity" />
            <burstCollective value="0" />
            <distribution type="fixed_vector">
                <fixed_vector x="0" y="0" z="0" />
            </distribution>
        </parameter>
        <parameter type="Float">
            <position x="10" y="210" />
            <name value="size" />
            <burstCollective value="0" />
            <distribution type="linear_random">
                <linear_random>
                    <from value="15" />
                    <to value="150" />
                </linear_random>
            </distribution>
        </parameter>
        <parameter type="Vector3">
            <position x="10" y="260" />
            <name value="color" />
            <burstCollective value="0" />
            <distribution type="fixed_vector">
                <fixed_vector x="0.200000003" y="0" z="0" />
            </distribution>
        </parameter>
        <parameter type="Float">
            <position x="10" y="310" />
            <name value="rotationRand" />
            <burstCollective value="0" />
            <distribution type="linear_random">
                <linear_random>
                    <from value="-60" />
                    <to value="60" />
                </linear_random>
            </distribution>
        </parameter>
        <parameter type="Vector3">
            <position x="10" y="360" />
            <name value="Vector3" />
            <burstCollective value="0" />
            <distribution type="linear_random_vector">
                <linear_random_vector>
                    <from x="0.800000012" y="0.600000024" z="0.200000003" />
                    <to x="1" y="0.5" z="0.100000001" />
                </linear_random_vector>
            </distribution>
        </parameter>
    </parameters>
    <modifiers>
        <modifier type="Linear addition">
            <position x="517" y="70" />
            <speed value="1" />
        </modifier>
        <modifier type="Linear addition">
            <position x="517" y="130" />
            <speed value="-4" />
        </modifier>
        <modifier type="Move">
            <position x="517" y="190" />
        </modifier>
        <modifier type="Gravity">
            <position x="517" y="250" />
            <gravity x="0.000000" y="-30.000000" z="0.000000" />
        </modifier>
    </modifiers>
    <functions>
        <function type="Div">
            <position x="264" y="366" />
        </function>
        <function type="Sub">
            <position x="441" y="415" />
        </function>
        <function type="Distribution">
            <position x="264" y="460" />
            <distribution type="fixed">
                <fixed value="0.5" />
            </distribution>
        </function>
        <function type="Mul">
            <position x="441" y="487" />
        </function>
        <function type="Mul">
            <position x="461" y="603" />
        </function>
        <function type="Distribution">
            <position x="441" y="537" />
            <distribution type="fixed">
                <fixed value="4" />
            </distribution>
        </function>
        <function type="Distribution">
            <position x="441" y="290" />
            <distribution type="fixed">
                <fixed value="1" />
            </distribution>
        </function>
        <function type="Sub">
            <position x="604" y="574" />
        </function>
        <function type="Add (vector)">
            <position x="170" y="627" />
        </function>
        <function type="Mul">
            <position x="264" y="179" />
        </function>
    </functions>
    <generator type="Generator">
        <position x="517" y="10" />
        <phase_distribution type="fixed">
            <fixed value="0" />
        </phase_distribution>
        <time_distribution type="fixed">
            <fixed value="0.20000000000000001" />
        </time_distribution>
        <burst_distribution type="fixed">
            <fixed value="3" />
        </burst_distribution>
    </generator>
    <terminator type="Terminator: v1 &lt; v2">
        <position x="517" y="310" />
    </terminator>
    <constructor type="Constructor">
        <position x="517" y="370" />
        <slice_tex x="1" y="1" />
        <texture src="particles_ready/sprites/smoke.png" />
        <material src="materials/quad_tex.mat" />
    </constructor>
