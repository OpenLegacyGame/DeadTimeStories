<particles_layout>
    <world_emitting value="1" />
    <parameters>
        <parameter type="Float">
            <position x="10" y="10" />
            <name value="Life time" />
            <burstCollective value="0" />
            <distribution type="fixed">
                <fixed value="0" />
            </distribution>
        </parameter>
        <parameter type="Vector3">
            <position x="10" y="60" />
            <name value="Position" />
            <burstCollective value="0" />
            <distribution type="box_random">
                <box_random>
                    <from x="0" y="0" z="0" />
                    <to x="160" y="70" z="0" />
                </box_random>
            </distribution>
        </parameter>
        <parameter type="Spawn Global Position">
            <position x="10" y="110" />
            <name value="Spawn world. pos." />
        </parameter>
        <parameter type="Vector3">
            <position x="10" y="160" />
            <name value="Velocity" />
            <burstCollective value="0" />
            <distribution type="box_random">
                <box_random>
                    <from x="-5" y="-5" z="0" />
                    <to x="5" y="5" z="0" />
                </box_random>
            </distribution>
        </parameter>
        <parameter type="Float">
            <position x="10" y="210" />
            <name value="Rotation" />
            <burstCollective value="0" />
            <distribution type="linear_random">
                <linear_random>
                    <from value="0" />
                    <to value="360" />
                </linear_random>
            </distribution>
        </parameter>
        <parameter type="Vector3">
            <position x="10" y="260" />
            <name value="Color" />
            <burstCollective value="0" />
            <distribution type="fixed_vector">
                <fixed_vector x="0.300000012" y="0.200000003" z="4" />
            </distribution>
        </parameter>
        <parameter type="Float">
            <position x="10" y="310" />
            <name value="Size" />
            <burstCollective value="0" />
            <distribution type="linear_random">
                <linear_random>
                    <from value="1" />
                    <to value="30" />
                </linear_random>
            </distribution>
        </parameter>
    </parameters>
    <modifiers>
        <modifier type="Linear addition">
            <position x="679" y="70" />
            <speed value="1" />
        </modifier>
        <modifier type="Move">
            <position x="679" y="130" />
        </modifier>
        <modifier type="Gravity">
            <position x="679" y="190" />
            <gravity x="-0.500000" y="-0.500000" z="-5.000000" />
        </modifier>
    </modifiers>
    <functions>
        <function type="Distribution">
            <position x="200" y="362" />
            <distribution type="fixed">
                <fixed value="1" />
            </distribution>
        </function>
        <function type="Div">
            <position x="290" y="123" />
        </function>
        <function type="Split">
            <position x="164" y="177" />
        </function>
        <function type="Div">
            <position x="290" y="177" />
        </function>
        <function type="Join">
            <position x="458" y="150" />
        </function>
        <function type="Div">
            <position x="349" y="439" />
        </function>
        <function type="Distribution">
            <position x="337" y="377" />
            <distribution type="fixed">
                <fixed value="1.5" />
            </distribution>
        </function>
        <function type="Sub">
            <position x="500" y="406" />
        </function>
        <function type="Add (vector)">
            <position x="290" y="52" />
        </function>
    </functions>
    <generator type="Generator">
        <position x="679" y="10" />
        <phase_distribution type="fixed">
            <fixed value="1" />
        </phase_distribution>
        <time_distribution type="fixed">
            <fixed value="2" />
        </time_distribution>
        <burst_distribution type="fixed">
            <fixed value="150" />
        </burst_distribution>
    </generator>
    <terminator type="Terminator: v1 &lt; v2">
        <position x="679" y="250" />
    </terminator>
    <constructor type="Constructor">
        <position x="679" y="310" />
        <slice_tex x="1" y="1" />
        <texture src="particles_ready/sprites/smoke.png" />
        <material src="materials/quad_tex_add.mat" />
    </constructor>
    <connections>
        <connection input_block="0" input_index="0" output_block="7" output_index="0" />
        <connection input_block="1" input_index="0" output_block="8" output_index="0" />
        <connection input_block="5" input_index="0" output_block="9" output_index="0" />
        <connection input_block="7" input_index="0" output_block="0" output_index="0" />
        <connection input_block="8" input_index="0" output_block="1" output_index="0" />
        <connection input_block="8" input_index="1" output_block="14" output_index="0" />
        <connection input_block="9" input_index="0" output_block="5" output_index="0" />
        <connection input_block="11" input_index="0" output_block="12" output_index="0" />
        <connection input_block="11" input_index="1" output_block="0" output_index="0" />
        <connection input_block="12" input_index="0" output_block="3" output_index="0" />
        <connection input_block="13" input_index="0" output_block="12" output_index="1" />
        <connection input_block="13" input_index="1" output_block="0" output_index="0" />
        <connection input_block="14" input_index="0" output_block="11" output_index="0" />
        <connection input_block="14" input_index="1" output_block="13" output_index="0" />
        <connection input_block="14" input_index="2" output_block="12" output_index="2" />
        <connection input_block="15" input_index="0" output_block="0" output_index="0" />
        <connection input_block="15" input_index="1" output_block="10" output_index="0" />
        <connection input_block="17" input_index="0" output_block="16" output_index="0" />
        <connection input_block="17" input_index="1" output_block="15" output_index="0" />
        <connection input_block="18" input_index="0" output_block="1" output_index="0" />
        <connection input_block="18" input_index="1" output_block="2" output_index="0" />
        <connection input_block="20" input_index="0" output_block="10" output_index="0" />
        <connection input_block="20" input_index="1" output_block="0" output_index="0" />
        <connection input_block="21" input_index="0" output_block="18" output_index="0" />
        <connection input_block="21" input_index="1" output_block="6" output_index="0" />
        <connection input_block="21" input_index="2" output_block="5" output_index="0" />
        <connection input_block="21" input_index="3" output_block="17" output_index="0" />
        <connection input_block="21" input_index="4" output_block="4" output_index="0" />
    </connections>
</particles_layout>
