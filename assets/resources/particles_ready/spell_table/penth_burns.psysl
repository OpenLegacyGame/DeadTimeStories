<particles_layout>
    <world_emitting value="1" />
    <parameters>
        <parameter type="Float">
            <position x="10" y="10" />
            <name value="terminate" />
            <burstCollective value="0" />
            <distribution type="fixed">
                <fixed value="5" />
            </distribution>
        </parameter>
        <parameter type="Float">
            <position x="10" y="60" />
            <name value="Life time" />
            <burstCollective value="0" />
            <distribution type="fixed">
                <fixed value="0" />
            </distribution>
        </parameter>
        <parameter type="Vector3">
            <position x="10" y="110" />
            <name value="Position" />
            <burstCollective value="0" />
            <distribution type="box_random">
                <box_random>
                    <from x="460" y="270" z="0" />
                    <to x="840" y="600" z="0" />
                </box_random>
            </distribution>
        </parameter>
        <parameter type="Vector3">
            <position x="10" y="160" />
            <name value="Velocity" />
            <burstCollective value="0" />
            <distribution type="fixed_vector">
                <fixed_vector x="0" y="0" z="0" />
            </distribution>
        </parameter>
        <parameter type="Float">
            <position x="10" y="210" />
            <name value="size" />
            <burstCollective value="0" />
            <distribution type="linear_random">
                <linear_random>
                    <from value="110" />
                    <to value="200" />
                </linear_random>
            </distribution>
        </parameter>
        <parameter type="Vector3">
            <position x="10" y="260" />
            <name value="color" />
            <burstCollective value="0" />
            <distribution type="fixed_vector">
                <fixed_vector x="0" y="0" z="0" />
            </distribution>
        </parameter>
        <parameter type="Float">
            <position x="10" y="310" />
            <name value="rotationRand" />
            <burstCollective value="0" />
            <distribution type="linear_random">
                <linear_random>
                    <from value="-60" />
                    <to value="60" />
                </linear_random>
            </distribution>
        </parameter>
        <parameter type="Vector3">
            <position x="10" y="360" />
            <name value="Vector3" />
            <burstCollective value="0" />
            <distribution type="linear_random_vector">
                <linear_random_vector>
                    <from x="0.800000012" y="0.100000001" z="0" />
                    <to x="0.5" y="0.5" z="0" />
                </linear_random_vector>
            </distribution>
        </parameter>
        <parameter type="Float">
            <position x="10" y="410" />
            <name value="Float" />
            <burstCollective value="0" />
            <distribution type="fixed">
                <fixed value="0.5" />
            </distribution>
        </parameter>
    </parameters>
    <modifiers>
        <modifier type="Linear addition">
            <position x="517" y="70" />
            <speed value="1" />
        </modifier>
        <modifier type="Linear addition">
            <position x="517" y="130" />
            <speed value="20" />
        </modifier>
        <modifier type="Move">
            <position x="517" y="190" />
        </modifier>
        <modifier type="Gravity">
            <position x="517" y="250" />
            <gravity x="0.000000" y="-50.000000" z="0.000000" />
        </modifier>
        <modifier type="Gravity">
            <position x="517" y="310" />
            <gravity x="0.100000" y="0.100000" z="0.100000" />
        </modifier>
        <modifier type="Linear addition">
            <position x="517" y="370" />
            <speed value="1" />
        </modifier>
    </modifiers>
    <functions>
        <function type="Div">
            <position x="210" y="359" />
        </function>
        <function type="Sub">
            <position x="241" y="414" />
        </function>
        <function type="Distribution">
            <position x="175" y="523" />
            <distribution type="fixed">
                <fixed value="0.5" />
            </distribution>
        </function>
        <function type="Mul">
            <position x="343" y="467" />
        </function>
        <function type="Mul">
            <position x="386" y="523" />
        </function>
        <function type="Distribution">
            <position x="313" y="570" />
            <distribution type="fixed">
                <fixed value="4" />
            </distribution>
        </function>
        <function type="Sub">
            <position x="386" y="669" />
        </function>
        <function type="Add (vector)">
            <position x="210" y="639" />
        </function>
        <function type="Mul">
            <position x="343" y="183" />
        </function>
    </functions>
    <generator type="Generator">
        <position x="517" y="10" />
        <phase_distribution type="fixed">
            <fixed value="1" />
        </phase_distribution>
        <time_distribution type="fixed">
            <fixed value="100000000" />
        </time_distribution>
        <burst_distribution type="fixed">
            <fixed value="50" />
        </burst_distribution>
    </generator>
    <terminator type="Terminator: v1 &lt; v2">
        <position x="517" y="430" />
    </terminator>
    <constructor type="Constructor">
        <position x="517" y="490" />
        <slice_tex x="1" y="1" />
        <texture src="particles_ready/sprites/smoke.png" />
        <material src="materials/quad_tex_add.mat" />
    </constructor>
    <connections>
