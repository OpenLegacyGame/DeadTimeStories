        <connection input_block="8" input_index="0" output_block="14" output_index="0" />
        <connection input_block="9" input_index="0" output_block="1" output_index="0" />
        <connection input_block="10" input_index="0" output_block="4" output_index="0" />
        <connection input_block="11" input_index="0" output_block="2" output_index="0" />
        <connection input_block="11" input_index="1" output_block="3" output_index="0" />
        <connection input_block="12" input_index="0" output_block="3" output_index="0" />
        <connection input_block="13" input_index="0" output_block="7" output_index="0" />
        <connection input_block="14" input_index="0" output_block="8" output_index="0" />
        <connection input_block="15" input_index="0" output_block="1" output_index="0" />
        <connection input_block="15" input_index="1" output_block="0" output_index="0" />
        <connection input_block="16" input_index="0" output_block="15" output_index="0" />
        <connection input_block="16" input_index="1" output_block="17" output_index="0" />
        <connection input_block="18" input_index="0" output_block="16" output_index="0" />
        <connection input_block="18" input_index="1" output_block="16" output_index="0" />
        <connection input_block="19" input_index="0" output_block="18" output_index="0" />
        <connection input_block="19" input_index="1" output_block="20" output_index="0" />
        <connection input_block="21" input_index="0" output_block="8" output_index="0" />
        <connection input_block="21" input_index="1" output_block="19" output_index="0" />
        <connection input_block="22" input_index="0" output_block="5" output_index="0" />
        <connection input_block="22" input_index="1" output_block="7" output_index="0" />
        <connection input_block="23" input_index="0" output_block="1" output_index="0" />
