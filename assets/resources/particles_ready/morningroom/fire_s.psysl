                </box_random>
            </distribution>
        </parameter>
        <parameter type="Float">
            <position x="10" y="210" />
            <name value="terminate" />
            <burstCollective value="0" />
            <distribution type="linear_random">
                <linear_random>
                    <from value="0.800000012" />
                    <to value="1" />
                </linear_random>
            </distribution>
        </parameter>
        <parameter type="Float">
            <position x="10" y="260" />
            <name value="size" />
            <burstCollective value="0" />
            <distribution type="fixed">
                <fixed value="120" />
            </distribution>
        </parameter>
    </parameters>
    <modifiers>
        <modifier type="Linear addition">
            <position x="707" y="70" />
            <speed value="1" />
        </modifier>
