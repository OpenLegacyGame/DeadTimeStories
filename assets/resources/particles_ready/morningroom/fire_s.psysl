<particles_layout>
    <world_emitting value="1" />
    <parameters>
        <parameter type="Float">
            <position x="10" y="10" />
            <name value="Life time" />
            <burstCollective value="0" />
            <distribution type="fixed">
                <fixed value="0" />
            </distribution>
        </parameter>
        <parameter type="Vector3">
            <position x="10" y="60" />
            <name value="Position" />
            <burstCollective value="0" />
            <distribution type="linear_random_vector">
                <linear_random_vector>
                    <from x="-7" y="0" z="0" />
                    <to x="7" y="0" z="0" />
                </linear_random_vector>
            </distribution>
        </parameter>
        <parameter type="Spawn Global Position">
            <position x="10" y="110" />
            <name value="Spawn world. pos." />
        </parameter>
        <parameter type="Vector3">
            <position x="10" y="160" />
            <name value="Velocity" />
