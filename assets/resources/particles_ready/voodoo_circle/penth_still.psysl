<particles_layout>
    <world_emitting value="1" />
    <parameters>
        <parameter type="Float">
            <position x="10" y="10" />
            <name value="Life time" />
            <burstCollective value="0" />
            <distribution type="fixed">
                <fixed value="0" />
            </distribution>
        </parameter>
        <parameter type="Vector3">
            <position x="10" y="60" />
            <name value="Position" />
            <burstCollective value="0" />
            <distribution type="linear_random_vector">
                <linear_random_vector>
                    <from x="-10" y="0" z="0" />
                    <to x="10" y="0" z="0" />
                </linear_random_vector>
            </distribution>
        </parameter>
        <parameter type="Spawn Global Position">
            <position x="10" y="110" />
            <name value="Spawn world. pos." />
        </parameter>
        <parameter type="Vector3">
            <position x="10" y="160" />
            <name value="Velocity" />
            <burstCollective value="0" />
            <distribution type="box_random">
                <box_random>
                    <from x="0" y="-80" z="0" />
                    <to x="0" y="-60" z="0" />
                </box_random>
            </distribution>
        </parameter>
        <parameter type="Float">
            <position x="10" y="210" />
            <name value="terminate" />
            <burstCollective value="0" />
            <distribution type="fixed">
                <fixed value="0.5" />
            </distribution>
        </parameter>
        <parameter type="Float">
            <position x="10" y="260" />
            <name value="size" />
            <burstCollective value="0" />
            <distribution type="fixed">
                <fixed value="150" />
            </distribution>
        </parameter>
    </parameters>
    <modifiers>
        <modifier type="Linear addition">
            <position x="668" y="70" />
            <speed value="1" />
        </modifier>
        <modifier type="Move">
            <position x="668" y="130" />
        </modifier>
        <modifier type="Linear addition">
            <position x="668" y="190" />
            <speed value="-130" />
        </modifier>
    </modifiers>
    <functions>
