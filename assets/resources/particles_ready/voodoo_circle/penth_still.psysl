            <position x="166" y="108" />
        </function>
        <function type="Distribution">
            <position x="18" y="490" />
            <distribution type="fixed">
                <fixed value="0" />
            </distribution>
        </function>
        <function type="InterpTrack3">
            <position x="255" y="329" />
            <trackX>
                <looped left="0" right="0" />
                <key type="1" corner="0" broken="0" time="0.299999982" in="0.560000002" out="0.560000002" intanx="-0.435988247" intany="0.111419201" outtanx="0.449999988" outtany="0" />
            </trackX>
            <trackY>
                <looped left="0" right="0" />
                <key type="1" corner="0" broken="0" time="0.299999982" in="0.400000006" out="0.400000006" intanx="-0.449999988" intany="-0" outtanx="0.449999988" outtany="0" />
            </trackY>
            <trackZ>
                <looped left="0" right="0" />
                <key type="1" corner="0" broken="0" time="0.299999982" in="0.600000024" out="0.600000024" intanx="-0.446676075" intany="0.0545937382" outtanx="0.449999988" outtany="0" />
            </trackZ>
        </function>
        <function type="Div">
            <position x="214" y="207" />
        </function>
        <function type="InterpTrack">
            <position x="255" y="375" />
            <track>
                <looped left="0" right="0" />
                <key type="4" corner="0" broken="0" time="0" in="0.0695933849" out="0.0695933849" intanx="-1" intany="0" outtanx="0.44891423" outtany="-0.0312414616" />
                <key type="4" corner="0" broken="0" time="1" in="0" out="0" intanx="-0.44891423" intany="0.0312414616" outtanx="0.449999988" outtany="0" />
            </track>
        </function>
    </functions>
    <generator type="Generator">
        <position x="668" y="10" />
        <phase_distribution type="linear_random">
            <linear_random>
                <from value="0" />
                <to value="1" />
            </linear_random>
        </phase_distribution>
        <time_distribution type="linear_random">
            <linear_random>
                <from value="0.029999999999999999" />
                <to value="0.080000000000000002" />
            </linear_random>
        </time_distribution>
        <burst_distribution type="fixed">
            <fixed value="1" />
        </burst_distribution>
    </generator>
    <terminator type="Terminator: v1 &lt; v2">
        <position x="668" y="250" />
    </terminator>
    <constructor type="Constructor">
