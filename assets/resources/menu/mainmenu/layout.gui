	</button>
	<button id="credits">
		<view>
			<normal src="bt_credits_E" />
			<hover src="bt_credits_O" />
			<clicked src="bt_credits_T" />
		</view>
		<mask src="bt_credits_back" />
		<position x="734" y="574" />
	</button>
	<image>
		<file src="flora_right" />
		<position x="763" y="483" />
	</image>
</gui>