<replacement src="frames.xml" /><animation_set looped="1">	<animation type="keys" applier="picture" priority="0" weight="1.0" start="0.0" looped="0">		<keys type="picture">			<cyclic value="0" />			<picture>				<key relative_time="0.0">moon01</key>				<key relative_time="{wait}">moon01</key>				<key relative_time="{fadein}">moon01</key>				<key relative_time="{smile_before}">moon02</key>				<key relative_time="{blink}">moon01</key>			</picture>		</keys>	</animation>		<animation type="keys" applier="alpha" priority="0" weight="1.0" start="0.0" looped="0">		<keys type="float">			<cyclic value="0" />			<float>				<key relative_time="0.0">0</key>				<key relative_time="{wait}">0</key>				<key relative_time="{fadein}">1</key>				<key relative_time="{smile_before}">1</key>				<key relative_time="{blink}">1</key>				<key relative_time="0.7">0.3</key>				<key relative_time="4">0.0</key>			</float>		</keys>	</animation></animation_set>