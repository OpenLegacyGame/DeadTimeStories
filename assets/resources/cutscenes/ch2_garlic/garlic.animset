<animation_set looped="0">	<animation type="keys" applier="visible" priority="0" weight="1.0" start="0.0" looped="0">		<keys type="float">			<cyclic value="0" />			<float>				<key relative_time="0">0</key>				<!-- 1 -->				<key relative_time="2">0</key>				<!-- 2 -->				<key relative_time="3">0</key>				<!-- 3 -->				<key relative_time="3">0</key>				<!-- 4 -->				<key relative_time="3">1</key>				<!-- end -->				<key relative_time="6">1</key>			</float>		</keys>	</animation>		<animation type="keys" applier="rotationZ" priority="0" weight="1.0" start="0.0" looped="0">		<keys type="float">			<cyclic value="0" />			<float>				<key relative_time="0">0</key>				<!-- 1 -->				<key relative_time="2">0</key>				<!-- 2 -->				<key relative_time="3">0</key>				<!-- 3 -->				<key relative_time="3">0</key>				<!-- 4 -->				<key relative_time="3">0</key>				<key relative_time="0.35">90</key>				<key relative_time="0.35">180</key>				<key relative_time="0.35">270</key>				<key relative_time="0.35">360</key>				<key relative_time="0.35">270</key>				<key relative_time="0.35">180</key>				<key relative_time="0.35">90</key>				<key relative_time="0.15">45</key>				<key relative_time="0.15">0</key>				<key relative_time="2">0</key>			</float>		</keys>	</animation>		<animation type="keys" applier="position" priority="0" weight="1.0" start="0.0" looped="0">		<keys type="vector3">			<cyclic value="0" />			<vector3>				<key relative_time="0">0 0 0</key>				<!-- 1 -->				<key relative_time="2">0 0 0</key>				<!-- 2 -->				<key relative_time="3">0 0 0</key>				<!-- 3 -->				<key relative_time="3">0 0 0</key>				<!-- 4 -->				<key relative_time="2">397 81 0</key>				<key relative_time="1">397 81 0</key>								<key relative_time="0.35">357 91 -1</key>				<key relative_time="0.35">311 183 -1</key>				<key relative_time="0.35">283 281 -1</key>				<key relative_time="0.35">277 381 -1</key>				<key relative_time="0.35">367 283 -1</key>				<key relative_time="0.35">461 313 -1</key>				<key relative_time="0.35">511 421 -1</key>				<key relative_time="0.35">537 557 -1</key>				<key relative_time="0.15">557 537 -1</key>				<key relative_time="0.15">577 557 -1</key>								<!-- end -->				<key relative_time="2">577 557 -1</key>			</vector3>		</keys>	</animation>	</animation_set>