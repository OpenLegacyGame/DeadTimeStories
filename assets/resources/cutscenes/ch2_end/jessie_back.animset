<replacement src="frames.xml" /><animation_set looped="0">	<animation type="keys" applier="visible" priority="0" weight="1.0" start="0.0" looped="0">		<keys type="float">			<cyclic value="0" />			<float>				<key relative_time="0">1</key>				<!-- 1 -->				<key relative_time="2">1</key>				<!-- 2 -->				<key relative_time="{1}">1</key>				<key relative_time="0">0</key>				<!-- 3 -->				<key relative_time="{2}">0</key>				<key relative_time="0">1</key>				<!-- 4 -->				<key relative_time="{3}">1</key>				<key relative_time="0">0</key>				<!-- 5 -->				<key relative_time="{4}">0</key>				<key relative_time="0">0</key>				<!-- end -->				<key relative_time="{5}">0</key>			</float>		</keys>	</animation>		<animation type="keys" applier="position" priority="0" weight="1.0" start="0.0" looped="0">		<keys type="vector3">			<cyclic value="0" />			<vector3>				<key relative_time="0">400 150 0</key>				<!-- 1 -->				<key relative_time="2">400 150 0</key>				<!-- 2 -->				<key relative_time="{1}">400 150 0</key>				<key relative_time="0">0 0 0</key>				<!-- 3 -->				<key relative_time="{2}">0 0 0</key>				<key relative_time="0">1024 90 0</key>				<!-- 4 -->				<key relative_time="{3/2}">700 90 0</key>				<key relative_time="{3/2}">700 90 0</key>				<key relative_time="0">0 0 0</key>				<!-- 5 -->				<key relative_time="{4}">0 0 0</key>				<key relative_time="0">0 0 0</key>				<!-- end -->				<key relative_time="{5}">0 0 0</key>			</vector3>		</keys>	</animation>		<animation type="keys" applier="scale" priority="0" weight="1.0" start="0.0" looped="0">		<keys type="float">			<cyclic value="0" />			<float>				<key relative_time="0">0.8</key>				<!-- 1 -->				<key relative_time="2">0.8</key>				<!-- 2 -->				<key relative_time="{1}">0.8</key>				<key relative_time="0">1</key>				<!-- 3 -->				<key relative_time="{2}">1</key>				<key relative_time="0">1.2</key>				<!-- 4 -->				<key relative_time="{3/2}">1</key>				<key relative_time="{3/2}">1</key>				<key relative_time="0">1</key>				<!-- 5 -->				<key relative_time="{4}">1</key>				<key relative_time="0">1</key>				<!-- end -->				<key relative_time="{5}">1</key>			</float>		</keys>	</animation></animation_set>	