<animation_set looped="0">
	<animation type="keys" applier="scale" priority="1" weight="1.0" start="0.0" looped="0">
		<keys type="float">
			<cyclic value="0" />
			<float>
				<key relative_time="0.0">1.00</key>
				<key relative_time="12.0">1.3</key>
			</float>
		</keys>
	</animation>
	<animation type="keys" applier="position" priority="1" weight="1.0" start="0.0" looped="0">
		<keys type="vector3">
			<cyclic value="0" />
			<vector3>
				<key relative_time="0.0">0 0 0</key>
				<key relative_time="10.0">-200 -100 0</key>
			</vector3>
		</keys>
	</animation>
</animation_set>