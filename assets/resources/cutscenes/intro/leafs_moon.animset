<animation_set looped="0">
	<animation type="keys" applier="position" priority="0" weight="1.0" start="0.0" looped="0">
		<keys type="vector3">
			<cyclic value="0" />
			<vector3>
				<key relative_time="0.0">-3200 300 0</key>
				<key relative_time="3">1024 300 0</key>
			</vector3>
		</keys>
	</animation>
	
	<animation type="keys" applier="scale" priority="0" weight="1.0" start="0.0" looped="0">
		<keys type="float">
			<cyclic value="0" />
			<float>
				<key relative_time="0.0">2</key>
				<key relative_time="3">0.3</key>
			</float>
		</keys>
	</animation>
	
	<animation type="keys" applier="alpha" priority="0" weight="1.0" start="0.0" looped="0">
		<keys type="float">
			<cyclic value="0" />
			<float>
				<key relative_time="0.0">1</key>
				<key relative_time="3">0</key>
			</float>
		</keys>
	</animation>
</animation_set>