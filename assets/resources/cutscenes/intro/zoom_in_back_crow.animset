<animation_set looped="0">
	<animation type="keys" applier="scale" priority="1" weight="1.0" start="0.0" looped="0">
		<keys type="float">
			<cyclic value="0" />
			<float>
				<key relative_time="0.0">1.00</key>
				<key relative_time="10.0">1.8</key>
			</float>
		</keys>
	</animation>
	<animation type="keys" applier="position" priority="1" weight="1.0" start="0.0" looped="0">
		<keys type="vector3">
			<cyclic value="0" />
			<vector3>
				<key relative_time="0.0">420 566 0</key>
				<key relative_time="10.0">600 560 0</key>
			</vector3>
		</keys>
	</animation>
	<animation type="keys" applier="alpha" priority="0" weight="1.0" start="0.0" looped="0">
		<keys type="float">
			<cyclic value="0" />
			<float>
				<key relative_time="0.0">0.8</key>
				<key relative_time="10.0">0.9</key>
			</float>
		</keys>
	</animation>
</animation_set>