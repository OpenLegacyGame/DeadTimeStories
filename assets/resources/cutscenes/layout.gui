<gui>
	<button id="skip">
		<position x="800" y="20" />
		<mask src="/cutscenes/gui/skip_mask" />
		<influence>
			<hover>
				<onEnter><skip_label text_color="FFDCDCDC" /></onEnter>
				<onLeave><skip_label text_color="FF707070" /></onLeave>
			</hover>
		</influence>
		
		<label id="skip_label">
			<position x="40" y="30" />
			<text font="/fonts/times_18" color="FF707070">%跳过场景%</text>
		</label>
	</button>
</gui>