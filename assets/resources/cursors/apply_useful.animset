<animation_set looped="1">
	<animation type="keys" applier="scale" priority="1" weight="1.0" start="0.0" looped="0">
		<keys type="float">
			<cyclic value="0" />
			<float>
				<key relative_time="0.0">1</key>
				<key relative_time="0.2">0.8</key>
				<key relative_time="0.4">1</key>
			</float>
		</keys>
	</animation>
