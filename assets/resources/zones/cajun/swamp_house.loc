			<position x="335" y="496" z="-35" />		
			<particles src="/particles_ready/Blink/blink.psysl" />
		</object>
		<object name="alligator_4">
			<position x="154" y="424" z="-25" />
			<texture src="swamp_house/alligator_4/alligator_4" />
			<script src="swamp_house/alligator_4/alligator_4" />
		</object>	
		<object name="fx_blink_alligator_4">
			<position x="154" y="424" z="-30" />		
			<particles src="/particles_ready/Blink/blink.psysl" />
		</object>
		<object name="alligator_5">
			<position x="319" y="396" z="-20" />
			<texture src="swamp_house/alligator_5/alligator_5" />
			<script src="swamp_house/alligator_5/alligator_5" />
		</object>	
		<object name="fx_blink_alligator_5">
			<position x="319" y="396" z="-25" />		
			<particles src="/particles_ready/Blink/blink.psysl" />
		</object>		
		<object name="alligator_6">
			<position x="602" y="335" z="-20" />
			<texture src="swamp_house/alligator_6/alligator_6" />
			<script src="swamp_house/alligator_6/alligator_6" />
		</object>	
