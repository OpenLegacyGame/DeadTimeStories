<location>
	<onFirstVisit script="swamp_house/starter" />
	<onEnter script="swamp_house/on_enter" />
	
	<music>
		<track src="/music/06_Cajun_Swamp" silence_after="5" />
		<track src="/music/07_Cajun_Swamp_Mystery" silence_after="5" />
		<track src="/music/08_Naughty_Spirits" silence_after="5" />
		<track src="/music/01_DTS_Theme" silence_after="5" />
		<track src="/music/10_Grand_Finale" silence_after="5" />
	</music>
	<ambient src="/music/ambient/sfx_crickets" />
	<objects>
		<object name="background">
			<position z="10" />
			<texture src="swamp_house/background" />
		</object>
		
		<object name="top">
			<position z="5" />
			<texture src="swamp_house/top" />
		</object>
		<object name="carriage_trigger">
			<script src="swamp_house/carriage_trigger" />		
		</object>		
		<object name="fx_fog">
			<position z="9" />
			<particles presim="5" src="/particles_ready/cemeterygates/fog.psysl" />
		</object>
		
		<object name="fx_lamp">
			<scene src="/particles_ready/swamphouse/lamp.DAE">
				<particles src="/particles_ready/cemeterygates/lamp.psysl" />
			</scene>
		</object>
		
		<object name="fx_water">
			<scene src="/particles_ready/swamphouse/water.DAE">
				<particles src="/particles_ready/swamp/swamp_water.psysl" />
			</scene>
		</object>
		
		<object name="fx_deepeyes">
			<scene src="/particles_ready/swamphouse/deep_eyes.DAE">
				<particles src="/particles_ready/swamp/deep_eyes.psysl" />
			</scene>
		</object>
		
		<object name="swamp_house_carriage">
			<position x="876" y="359" z="-15" />
			<texture src="swamp_house/swamp_house_carriage/carriage_mask" />
			<script src="swamp_house/swamp_house_carriage/swamp_house_carriage" />
			<alpha value="0" />
		</object>	
		<object name="to_swamp_island">
			<position x="767" y="75" z="-15" />
			<texture src="swamp_house/to_swamp_island" />
			<script src="swamp_house/to_swamp_island" />
			<alpha value="0" /> 
		</object>
		<object name="doll_head">
			<position x="670" y="189" z="-15" />
			<texture src="swamp_house/doll_head/doll_head" />
			<script src="swamp_house/doll_head/doll_head" />
		</object>	
		<object name="fx_blink_doll_head">
			<position x="680" y="200" z="-20" />		
			<particles src="/particles_ready/Blink/blink.psysl" />
		</object>
		<object name="house">
			<position x="79" y="115" z="-15" />
			<texture src="swamp_house/house/house_MASK" />
			<script src="swamp_house/house/house" />
			<alpha value="0" />
		</object>		
		<object name="fx_blink_house">
			<position x="140" y="130" z="-20" />		
			<particles src="/particles_ready/Blink/blink.psysl" />
		</object>	
		<object name="orange_1">
			<position x="136" y="141" z="-15" />
			<texture src="swamp_house/orange_1/orange_1" />
			<script src="swamp_house/orange_1/orange_1" />
		</object>	
		<object name="fx_blink_orange_1">
			<position x="146" y="151" z="-20" />		
			<particles src="/particles_ready/Blink/blink.psysl" />
		</object>
