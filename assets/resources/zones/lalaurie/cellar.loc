				<particles src="/particles_ready/cellarFlys/flys.psysl" />
				<particles src="/particles_ready/cellarFlys/flys_shadow.psysl" />
			</scene>
		</object>
		<object name="fx_reveal_place">
			<position z="-100" />
			<scene src="/particles_ready/helix/hlx_cellar.DAE" looped="1">
				<particles src="/particles_ready/helix/helix.psysl" />
			</scene>
		</object>
		
		<object name="sfx_wierd_rustle">
			<script src="cellar/sfx/wierd_rustle" />
		</object>
	</objects>
</location>
