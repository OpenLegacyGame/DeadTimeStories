<location stripcode="1100">
	<ambient src="/music/ambient/sfx_Bedroom_amb" />
	<objects>
		<object name="back">
			<texture src="bedroom/background" />
		</object>
		<object name="return">
			<position x="0" y="630" z="-10" />
			<size width="1024" height="150" />
			<texture src="/common/half_dark" />
			<script src="bedroom/bedroom_back" />
			<alpha value="0" />
		</object>
		<object name="pump_handle">
			<position x="414" y="588" z="-10" />
			<texture src="bedroom/pump_handle/pump_handle" />
			<script src="bedroom/pump_handle/pump_handle" />
			
		</object>
		<object name="fx_blink_pump_handle">
			<position x="520" y="610" z="-20" />		
			<particles src="/particles_ready/Blink/blink.psysl" />
		</object>
		<object name="music_box">
			<position x="855" y="517" z="-20" />
			<texture src="bedroom/music_box_inset/music_box_closed" />
			<script src="bedroom/music_box_inset/music_box" />
			<size width="100" height="100" />
		</object>
		<object name="fx_blink_music_box">
			<position x="905" y="567" z="-30" />		
			<particles src="/particles_ready/Blink/blink.psysl" />
		</object>
		<object name="empty_vial">
			<position x="105" y="293" z="-20" />
			<texture src="bedroom/empty_vial/empty_vial" />
			<script src="bedroom/empty_vial/empty_vial" />
		</object>
		<object name="fx_blink_empty_vial">
			<position x="130" y="302" z="-30" />		
			<particles src="/particles_ready/Blink/blink.psysl" />
		</object>
		<object name="saint">
			<position x="270" y="320" z="-20" />
			<texture src="/common/half_dark" />
			<script src="bedroom/saint_inset/saint" />
			<size width="50" height="120" />
			<alpha value="0" />
		</object>
		<object name="fx_blink_saint">
			<position x="295" y="340" z="-30" />		
			<particles src="/particles_ready/Blink/blink.psysl" />
		</object>
		<object name="candles">
			<position x="330" y="320" z="-20" />
			<texture src="/common/half_dark" />
			<script src="bedroom/candles" />
			<size width="50" height="120" />
			<alpha value="0" />
		</object>
		<object name="fx_blink_candles">
			<position x="355" y="340" z="-30" />		
			<particles src="/particles_ready/Blink/blink.psysl" />
		</object>
		<object name="bedside_table">
			<position x="550" y="420" z="-20" />
			<texture src="/common/half_dark" />
			<script src="bedroom/bedside_table/bedside_table" />
			<size width="150" height="100" />
			<alpha value="0" />
		</object>
<!--		<object name="fireplace">
			<position x="0" y="380" z="-20" />
			<texture src="/common/half_dark" />
			<script src="bedroom/fireplace" />
			<size width="140" height="220" />
			<alpha value="0" />
			<interactive value="0" />
		</object>-->
		<object name="gloves">
			<position x="790" y="540" z="-10" />
			<texture src="/common/half_dark" />
			<script src="bedroom/gloves" />
			<size width="100" height="50" />
			<alpha value="0" />
		</object>
		<object name="fx_flora_bedside_table">
			<position x="500" y="420" z="-5" />
			<particles presim="2" src="/particles_ready/FrontGate_HOBLocator/FGate_HOBLocator.psysl" />
		</object>
		<object name="fx_candles">
			
			<scene src="/particles_ready/candle/candles_bedroom.DAE" particles="/particles_ready/candle/candle.psysl" />
			<script src="bedroom/candles_fx" />
		</object>
		<object name="fx_ray_dust">
			<scene src="/particles_ready/ray_dust/bedroom_duster.DAE" particles="/particles_ready/ray_dust/ray_dust.psysl" />
		</object>
		<object name="fx_fire">
			<position z="-100" />
			<particles presim="1" src="/particles_ready/coals/bedroom_coals.psysl" />
		</object>
		<object name="fx_fire_stencil">
			<position y="537" z="-200" />
			<texture src="/particles_ready/coals/grate" />
		</object>
		<object name="fx_smoke">
			<scene src="/particles_ready/bedroom_smoke/bedroom_smoke.DAE">
				<particles presim="10" src="/particles_ready/bedroom_smoke/bedroom_smoke.psysl" />
			</scene>
		</object>
		
		<object name="sfx_wind">
			<script src="parlor/sfx/wind" />
		</object>
	</objects>
</location>
