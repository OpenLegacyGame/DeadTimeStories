<location>
	<music>
		<track src="/music/04_French_Quarter_Jazz_Carnavale" silence_after="5" />
		<track src="/music/05_French_Quarter_Tragic_Fate" silence_after="5" />
	</music> 
	<ambient src="/music/ambient/sfx_FR_Q_amb" />
	<onFirstVisit script="street_1/starter" />
	<onEnter script="street_1/on_enter" />
	<objects>
		<object name="background">
			<texture src="street_1/background" />
		</object>
		<object name="top">
			<position z="-3" />
			<texture src="street_1/build_top" />
			<interactive value="0" />
		</object>
		<object name="bottom">
			<position z="-2" />
			<texture src="street_1/build_bottom" />
			<interactive value="0" />
		</object>	
		<object name="lipstick_trigger">
			<script src="street_1/lipstick_trigger" />		
		</object>	
		<object name="carriage_trigger">
			<script src="street_1/carriage_trigger" />		
		</object>			
		<object name="fx_bats">
			<particles src="\particles_ready\bats\bats4.psysl" />
			<particles src="\particles_ready\bats\bats3.psysl" />
			<particles src="\particles_ready\bats\bats2.psysl" />
			<particles src="\particles_ready\bats\bats.psysl" />
		</object>
		<object name="fx_fog">
			<particles presim="3" src="/particles_ready/street_01/bg_fog.psysl" />
		</object>
		
		
		<object name="street_1_carriage">
			<position x="754" y="369" z="-15" />
