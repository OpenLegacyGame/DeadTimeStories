	<rounds>
		<round0
			congratulations="%非常好!\n\n你找到了碘.\n也许以后会有用.%"
			congratulations_image="/inventory/iodine"		
			script_complete="HOB_desk/complete_round0"
		>
			<slot00 group="group0" object="%碘%" />
			<slot01 group="group1" />
