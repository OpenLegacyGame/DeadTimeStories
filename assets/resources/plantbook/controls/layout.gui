<gui>
	<!-- NOTE: duplicate id "close" is intentional, the real button is defined later in the file.
	     Our goal is to allow closing the book by clicking anywhere outside of it,
		 so we create a second, invisible "close button" taking the whole screen,
		 and then overlap it with another non-functional button roughly covering the book area (which must be excluded).
	-->
	<button id="close"> 
		<mask src="/common/half_dark" width="1024" height="768" />
	</button>
	<button id="dummy">
		<position x="130" y="90" />
		<mask src="/common/half_dark" width="745" height="500" />
	</button>
	
	<button id="prev_page" shortcuts="left">
		<position x="170" y="110" />
		<mask src="/common/half_dark" width="310" height="440" />
		<influence>
			<normal>
				<onEnter> <arrow_left texture="bt_arrow_left_pb_E" visible="1" /> </onEnter>
			</normal>
			<hover>
				<onEnter> <arrow_left texture="bt_arrow_left_pb_O" visible="1" /> </onEnter>
			</hover>
			<disabled>
				<onEnter> <arrow_left visible="0" /> </onEnter>
				<onLeave> <arrow_left visible="1" /> </onLeave>
			</disabled>
		</influence>
	</button>
	
	<image id="arrow_left" transparent="1">
		<file src="bt_arrow_left_pb_E" />
		<position x="401" y="453" />
	</image>

	<button id="next_page" shortcuts="right">
		<position x="490" y="110" />
		<mask src="/common/half_dark" width="350" height="440" />
		<influence>
			<normal>
				<onEnter> <arrow_right texture="bt_arrow_right_pb_E" visible="1" /> </onEnter>
			</normal>
			<hover>
				<onEnter> <arrow_right texture="bt_arrow_right_pb_O" visible="1" /> </onEnter>
			</hover>
			<disabled>
				<onEnter> <arrow_right visible="0" /> </onEnter>
				<onLeave> <arrow_right visible="1" /> </onLeave>
			</disabled>
		</influence>
	</button>
	
	<image id="arrow_right" transparent="1">
		<file src="bt_arrow_right_pb_E" />
		<position x="490" y="453" />
	</image>
	
	<button id="close" shortcuts="esc">
		<view>
			<normal src="bt_exit_pb_E" />
			<hover src="bt_exit_pb_O" />
		</view>
		<mask src="bt_exit_pb_E" />
		<position x="506" y="101" />
	</button>
</gui>