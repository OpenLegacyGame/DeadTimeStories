<animation_set looped="0">
	<animation type="const" applier="picture" priority="0" weight="1.0" start="0.0" looped="0">
		<const type="picture">/common/half_dark</const>
	</animation>
	<animation type="keys" applier="alpha" priority="0" weight="1.0" start="0.0" looped="0">
		<keys type="float">
			<cyclic value="0" />
			<float>
				<key relative_time="0.0">0.0</key>
				<key relative_time="3.0">1.0</key>
			</float>
		</keys>
	</animation>	
</animation_set>