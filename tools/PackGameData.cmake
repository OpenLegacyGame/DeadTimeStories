cmake_minimum_required(VERSION 3.24)
if(NOT IS_DIRECTORY "${INPUT_ROOT}" OR NOT OUTPUT_ARCHIVE)
  message(FATAL_ERROR "INPUT_ROOT and OUTPUT_ARCHIVE are required")
endif()
file(REAL_PATH "${INPUT_ROOT}" input)
file(REAL_PATH "." working)
if(NOT input STREQUAL working)
  message(FATAL_ERROR "Run this script with INPUT_ROOT as its working directory")
endif()
file(GLOB_RECURSE entries LIST_DIRECTORIES true RELATIVE "${input}" "${input}/*")
list(SORT entries)
set(paths)
set(keys)
set(extensions .a .anim .animset .csc .dae .font .fx .game .gui .hob .ifl .jpg .loc
    .lua .mat .ogg .psysl .scene .tga .tgui .txt .xml .zone .cfg .po .ttf)
foreach(path IN LISTS entries)
  if(IS_SYMLINK "${input}/${path}" OR path MATCHES "(^|/)\\.\\.(/|$)|[;\r\n\"$]" )
    message(FATAL_ERROR "Unsafe asset path: ${path}")
  endif()
  if(IS_DIRECTORY "${input}/${path}")
    continue()
  endif()
  string(TOLOWER "${path}" key)
  if(key IN_LIST keys)
    message(FATAL_ERROR "Case-colliding asset: ${path}")
  endif()
  list(APPEND keys "${key}")
  get_filename_component(extension "${key}" LAST_EXT)
  if(NOT extension IN_LIST extensions)
    message(FATAL_ERROR "Unexpected game input: ${path}")
  endif()
  file(SIZE "${input}/${path}" size)
  file(READ "${input}/${path}" magic LIMIT 8 HEX)
  if(size GREATER 134217728 OR magic MATCHES "^(4d5a|7f454c46|213c617263683e)")
    message(FATAL_ERROR "Executable or oversized input: ${path}")
  endif()
  if(extension STREQUAL ".a" AND NOT magic MATCHES "^ffd8")
    message(FATAL_ERROR "An .a source input must be a JPEG alpha image: ${path}")
  endif()
  list(APPEND paths "${path}")
endforeach()
if(NOT paths)
  message(FATAL_ERROR "No game inputs found")
endif()
get_filename_component(output_directory "${OUTPUT_ARCHIVE}" DIRECTORY)
file(MAKE_DIRECTORY "${output_directory}")
# Sorted paths and a fixed timestamp exclude original workstation metadata.
file(ARCHIVE_CREATE OUTPUT "${OUTPUT_ARCHIVE}.tmp" PATHS ${paths}
     FORMAT zip MTIME "2010-01-01 00:00:00 UTC")
file(RENAME "${OUTPUT_ARCHIVE}.tmp" "${OUTPUT_ARCHIVE}")
